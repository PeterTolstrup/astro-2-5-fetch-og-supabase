---
import Card from "../components/Card.astro";
import BrandingSection from "../components/BrandingSection.astro";

import PageLayout from "../layouts/PageLayout.astro";

const url = "https://halnlercergpfthawfgy.supabase.co/rest/v1/";
const tabel = "Animals";

const key = "sb_publishable_Kk6axxbdvzKOJ_nlU7gbXg_r2U0dlLm";

const options = {
  headers: {
    apikey: key
  }
}

const response = await fetch(url + tabel, options);
const animals = await response.json();

console.log("animals", animals);
---

<PageLayout title="Fetch Example" headline="An Example With Fetch" text="Soon you know">
  <section>
    <h2>Her kunne der være nogle cards</h2>
    <div class="cards">
      {
        animals.map((animal) => {
          return <Card headline={animal.name} text={animal.description} image={animal.image}/>
        })
      }
    </div>
  </section>
  <BrandingSection headline="Her er en Branding Section" text="Med en eller anden punchline" />
  <section>
    <h2>Her kunne der være noget tekst</h2>
    <p>Selvom folk ikke læser det</p>
    <div class="two-columns">
